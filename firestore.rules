rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper to check if the requesting user is an admin according to admins collection
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.isAdmin == true;
    }

    // Users may read their own record, but only an existing administrator may
    // create, update, or delete administrator records.
    match /admins/{adminId} {
      allow read: if request.auth != null && (request.auth.uid == adminId || isAdmin());
      allow create: if isAdmin();
      allow update, delete: if isAdmin();
    }

    // Content collections used by the app: public reads, writes only for admins
    match /{collection}/{docId} {
      allow read: if collection in [
        'portfolio',
        'skills',
        'projects',
        'experience',
        'education',
        'achievements',
        'socialLinks'
      ];
      allow create, update, delete: if isAdmin() && collection in [
        'portfolio',
        'skills',
        'projects',
        'experience',
        'education',
        'achievements',
        'socialLinks'
      ];
    }

    // Analytics events: allow only the event shapes emitted by the frontend.
    // Firestore rules cannot provide reliable per-client rate limiting; abuse
    // protection must be handled through quotas or a dedicated ingestion service.
    match /analytics/{eventType}/events/{eventId} {
      allow create: if eventType in [
          'page_view',
          'form_submission',
          'project_click',
          'resume_download'
        ]
        && request.resource.data.keys().hasOnly([
          'eventType',
          'data',
          'createdAt',
          'timestamp',
          'userAgent',
          'url'
        ])
        && request.resource.data.eventType == eventType
        && request.resource.data.data is map
        && request.resource.data.createdAt == request.time
        && request.resource.data.timestamp is number
        && request.resource.data.userAgent is string
        && request.resource.data.userAgent.size() <= 100
        && request.resource.data.url is string
        && request.resource.data.url.size() <= 2048;
      allow read, update, delete: if isAdmin();
    }

    // Audit log: admin actions only (admin write, admin read)
    match /auditLog/{logId} {
      allow create, read: if isAdmin();
      allow update, delete: if false;
    }

    // Fallback: deny by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
